# /opt/livro/<ambiente>/app.env — um arquivo por ambiente, só no servidor (chmod 600).
APP_ENV=staging
ENV_FILE=/opt/livro/staging/app.env
# Sobe os simuladores junto (só staging, até haver provedor real de STT)
COMPOSE_PROFILES=simuladores

# Supabase do ambiente (projeto próprio de staging/produção)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Domínio público do ambiente
NEXT_PUBLIC_SESSION_WS_URL=wss://staging.exemplo.com.br/ws
ALLOWED_ORIGINS=https://staging.exemplo.com.br

# Servidor de sessão
SESSION_PORT=4001
STT_PROVIDER=mock
MOCK_STT_URL=ws://mock-stt:4010/stt

# Observabilidade (vazio = desligado)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

# Serviço de exportação (só acessível de dentro da pilha)
EXPORT_PORT=4030
EXPORT_URL=http://export:4030

# Provedor de transcrição real (F1.03), escolhido no benchmark (F1.04):
# STT_PROVIDER=deepgram | assemblyai | elevenlabs
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_ZERO_RETENTION=true   (retenção zero exige plano enterprise)
# STT_USD_PER_MINUTE=              (preço do contrato, para o painel de custos)
# COST_MONTHLY_CAP_USD=50
