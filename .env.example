# Copie para .env e preencha. As chaves vêm do painel do Supabase (Project Settings → API Keys)
# ou de: supabase projects api-keys --project-ref <ref>
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Só no servidor e nos scripts de teste. Nunca em variável NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Servidor de sessão (WebSocket)
SESSION_PORT=4001
NEXT_PUBLIC_SESSION_WS_URL=ws://localhost:4001/ws
ALLOWED_ORIGINS=http://localhost:3000

# Transcrição: mock (simulador) | deepgram | assemblyai | elevenlabs (a partir de F1.03)
STT_PROVIDER=mock
MOCK_STT_URL=ws://localhost:4010/stt
MOCK_STT_CONTROL_URL=http://localhost:4010

# Serviço de exportação Word (chamado pelo web e pelo servidor de sessão)
EXPORT_PORT=4030
EXPORT_URL=http://localhost:4030

# Simuladores do Claude e do Sentry
MOCK_CLAUDE_PORT=4020
MOCK_SENTRY_PORT=4040

# Sentry (vazio = desligado). Para testar localmente: http://public@localhost:4040/1
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Senha dos usuários de teste criados pelo banco semente
E2E_PASSWORD=troque-esta-senha
